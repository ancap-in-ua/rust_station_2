/target

# PS2 BIOS dumps. Copyrighted Sony code -- legal to use from a console you
# own, never redistributable, so this must not be committed. scripts/
# run-pcsx2.sh looks here (see README's "Testing").
/bios_dump

# PCSX2 state generated by scripts/lib-pcsx2.sh (config, memcards, logs).
/.pcsx2
